{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AstroTunes",
  "version": "../package.json",
  "identifier": "com.codanaut.astrotunes",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AstroTunes",
        "resizable": true,
        "fullscreen": false,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/192x192.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "iOS": {
      "infoPlist": "./Info.ios.plist"
    }
  }
}